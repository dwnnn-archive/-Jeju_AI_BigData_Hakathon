# Copy to .env; keep secrets out of Git. Default service binds to 127.0.0.1.
DATABASE_PATH=runtime/jeju.sqlite
# API_TOKEN=replace-with-a-long-random-api-token
# APPROVER_TOKEN=replace-with-a-different-long-random-approval-token
APPROVER_ID=local-officer
ALLOW_MOCK_FALLBACK=false
WORKER_ENABLED=true
HEARTBEAT_SECONDS=2
WORKER_STALE_SECONDS=10
RESULT_TTL_SECONDS=3600
MAX_REFRESHES=1
HTTP_TIMEOUT=10
NOTIFICATION_MODE=mock

# Optional live input (use the decoded KMA service key).
# KMA_API_KEY=1725cd3e527d7a265227d62d1cec608c3e0db243d83e752faa57912ef96d8d01
# 기본값은 기상청 API허브(apihub.kma.go.kr) + authKey 입니다.
# 공공데이터포털(data.go.kr)에서 발급한 키라면 아래 둘을 함께 설정합니다(호출 확인 완료).
# KMA_BASE_URL=https://apis.data.go.kr/1360000/VilageFcstInfoService_2.0
# KMA_AUTH_PARAM=serviceKey
# 학습용 과거 실측 기상(ASOS 시간자료) 수집 키. 디코딩된 키를 넣습니다.
# ASOS_API_KEY=1725cd3e527d7a265227d62d1cec608c3e0db243d83e752faa57912ef96d8d01
# KPX 지역별 시간별 태양광·풍력 발전량 API(odcloud) 키. 디코딩된 키를 넣습니다.
# KPX_GEN_API_KEY=1725cd3e527d7a265227d62d1cec608c3e0db243d83e752faa57912ef96d8d01
# KPX_URL=https://your-authorized-adapter.example/jeju-demand
# MODEL_PATH=models/generation.json
# 제주 전체 단위 모델 폴더(scripts.train_jeju_model 출력). 설정하면 live 예측에 우선 사용합니다.
# JEJU_MODEL_DIR=models/jeju
# 제주 수요 예측 모델 폴더(scripts.train_demand_model 출력). KPX_URL이 없을 때 live 수요에 사용합니다.
# JEJU_DEMAND_MODEL_DIR=models/demand
# 예보 저장 장치(받은 예보 원본과 판정 기록). 기본은 켜짐이고 DB 파일 옆 forecasts.sqlite 에 쌓입니다.
# FORECAST_ARCHIVE_ENABLED=true
# FORECAST_ARCHIVE_PATH=runtime/forecasts.sqlite
# 하루 전이 정상인 날의 당일 점검(초단기예보) 최대 횟수. 기본 2회.
# MAX_INTRADAY_CHECKS=2
# 제주데이터허브 '전기자동차 충전소 정보' API 프로젝트 키(마이페이지 > 프로젝트 관리). 키는 Git에 올리지 않습니다.
# JEJUHUB_PROJECT_KEY=88obet_846e4o443p_88r00t4o34884t
# python -m scripts.collect_ev_stations 로 목록을 받아 runtime/ev_stations.json 에 저장합니다.
# EV_SNAPSHOT_PATH=runtime/ev_stations.json
# 충전기 1기 정격 출력(kW)과 남는 전력을 받아 줄 수 있는 비율은 가정값입니다.
# EV_SLOW_KW=7
# EV_FAST_KW=50
# EV_IDLE_RATIO=0.5
# PLANTS_PATH=data/fixtures/plants.json
# CORRECTIONS_PATH=data/corrections/plants.json

# Future verified-data integration only. Estimated/demo inputs are blocked.
# NOTIFICATION_MODE=webhook
# NOTIFICATION_URL=https://your-authorized-receiver.example/notifications
# NOTIFICATION_TOKEN=...

# 통보문 초안 문장을 Claude가 쓰게 하려면 키를 넣고 `uv sync --extra llm` 로 설치합니다.
# 수치는 항상 코드가 계산하고, LLM 문장의 숫자가 입력과 다르면 템플릿 초안으로 대체합니다.
# 키가 없거나 호출이 실패해도 분석은 템플릿 초안으로 이어집니다.
# ANTHROPIC_API_KEY=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
# LLM_MODEL=claude-opus-5-5
